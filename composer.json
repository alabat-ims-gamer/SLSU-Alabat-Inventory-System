{
    "name": "slsu/inventory-system",
    "description": "Web-Based Inventory Management and Properties Tracking System for SLSU-Alabat",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "scripts": {
        "migrate": "php database/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
