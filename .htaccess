<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct browser access to sensitive backend directories and files
    RewriteRule ^(app|config|database|views|vendor|\.env|\.env\.example|composer\.json|composer\.lock) - [F,L,NC]

    # Route all traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
