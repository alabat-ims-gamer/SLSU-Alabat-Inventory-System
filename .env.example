# Application Configuration
APP_NAME="SLSU-Alabat Inventory Management System"
APP_ENV=local
APP_DEBUG=true

# Base URL (Auto-detected if left empty; on local XAMPP auto-resolves to /slsu-inventory/public, on Railway auto-resolves to root /)
# Set explicitly only if you need a custom canonical domain or proxy prefix
# Local XAMPP: http://localhost/slsu-inventory/public
# Railway: https://your-production-app.up.railway.app
APP_URL=

# Database Configuration (XAMPP Local Default)
# On Railway with MySQL Plugin, these are automatically provided (MYSQLHOST, MYSQLPORT, etc.)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=slsu_inventory
DB_USER=root
DB_PASS=

# Session Configuration
SESSION_LIFETIME=900
SESSION_SECURE_COOKIE=false
